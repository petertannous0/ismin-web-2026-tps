// The schema is the source of truth: it describes the database AND the
// TypeScript types. The two cannot drift apart.

datasource db {
  provider = "sqlite"
}

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}


// 👉 STEP 2: Describe the `Model` entity, with the fields of
//    src/models/model.ts, same names. The README lists the decisions to make.
//
// Syntax reminder:
//   model Thing {
//     field Type @attribute
//   }
//
// Once written:  npx prisma migrate dev --name init
model Model {
  id             String       @id
  name           String
  
  // L'ancien champ `org String` disparaît et est remplacé par la relation
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  
  task           String
  parameters     Float
  downloads      Int
  license        String?
}

// 👉 L'Étape 5 : La nouvelle table Organisation
model Organisation {
  id      String  @id @default(uuid())
  slug    String  @unique
  name    String
  country String?
  models  Model[]
}